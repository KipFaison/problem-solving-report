      "start_time": "2026-01-13T16:15:02.000Z",
      "end_time": "2026-01-13T16:15:25.000Z"
    },
    {
      "_id": "19",
      "session_id": "demo-b-s01",
      "sequence_id": 20,
      "role": "STUDENT_1",
      "content": "Maybe we could check by multiplying 4 by 3 and seeing if we get back to 12.",
