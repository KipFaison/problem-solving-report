      "start_time": "2026-01-13T16:12:56.000Z",
      "end_time": "2026-01-13T16:14:00.000Z"
    },
    {
      "_id": "17",
      "session_id": "demo-b-s01",
      "sequence_id": 18,
      "role": "STUDENT_1",
      "content": "12 divided by 3 is 4, so maybe each part is 4 cups?",
