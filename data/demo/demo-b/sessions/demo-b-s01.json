      "start_time": "2026-01-13T16:11:15.000Z",
      "end_time": "2026-01-13T16:11:58.000Z"
    },
    {
      "_id": "15",
      "session_id": "demo-b-s01",
      "sequence_id": 16,
      "role": "STUDENT_1",
      "content": "Okay, so maybe I divide the 12 cups by 3 to get one part... does that work?",
