      "start_time": "2026-01-13T16:12:06.000Z",
      "end_time": "2026-01-13T16:12:56.000Z"
    },
    {
      "_id": "16",
      "session_id": "demo-b-s01",
      "sequence_id": 17,
      "role": "TUTOR",
      "content": "That's worth trying — what would that division actually give us?",
