      "end_time": "2026-01-13T16:17:26.000Z"
    },
    {
      "_id": "22",
      "session_id": "demo-b-s01",
      "sequence_id": 23,
      "role": "TUTOR",
      "content": "Okay, so we've got a part locked in — let's just sit with that for a second.",
