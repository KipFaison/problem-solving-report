      "start_time": "2026-01-13T16:16:11.000Z",
      "end_time": "2026-01-13T16:16:45.000Z"
    },
    {
      "_id": "21",
      "session_id": "demo-b-s01",
      "sequence_id": 22,
      "role": "STUDENT_1",
      "content": "4 times 3 is 12, so that matches the flour amount we were given.",
