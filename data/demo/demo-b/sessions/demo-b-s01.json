      "start_time": "2026-01-13T16:14:07.000Z",
      "end_time": "2026-01-13T16:14:55.000Z"
    },
    {
      "_id": "18",
      "session_id": "demo-b-s01",
      "sequence_id": 19,
      "role": "TUTOR",
      "content": "That seems reasonable — how could we double check that a part really is 4 cups?",
