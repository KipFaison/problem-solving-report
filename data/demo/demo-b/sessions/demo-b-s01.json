      "start_time": "2026-01-13T16:15:27.000Z",
      "end_time": "2026-01-13T16:16:08.000Z"
    },
    {
      "_id": "20",
      "session_id": "demo-b-s01",
      "sequence_id": 21,
      "role": "TUTOR",
      "content": "That sounds like a solid way to test it — want to try it?",
